# Server + web (Vite loads from repo root)
PORT=4000
APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
# Mobile Expo (physical phone: use PC LAN IP, e.g. http://192.168.1.10:4000)
API_URL=http://localhost:4000

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Cashfree subscription checkout (API requires credentials to start)
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=server-only-cashfree-secret
CASHFREE_ENV=sandbox
# Optional Cashfree webhook HMAC secret (required in production)
# CASHFREE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Resend / email OTP — DO NOT put Resend keys in VITE_* (browser).
# Configure SMTP inside Supabase Dashboard (Authentication → SMTP):
#   Host: smtp.resend.com
#   Port: 465
#   User: resend
#   Pass: re_... (Resend API key)
#   Sender: noreply@sportsarena.team  (domain must be Verified in Resend)
# Full steps: docs/RESEND_EMAIL_SETUP.md
# ---------------------------------------------------------------------------
