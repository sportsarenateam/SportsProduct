# Server + web (Vite loads from repo root)
PORT=4000
APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
# Mobile Expo (physical phone: use PC LAN IP, e.g. http://192.168.1.10:4000)
API_URL=http://localhost:4000

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Razorpay SaaS subscription checkout (required)
# Test: rzp_test_...  |  Live/production: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=server-only
RAZORPAY_WEBHOOK_SECRET=server-only
# Optional override if key prefix is not enough: test | live
# RAZORPAY_MODE=test

# ---------------------------------------------------------------------------
# Resend / email OTP — DO NOT put Resend keys here for Auth emails.
# Configure SMTP inside Supabase Dashboard (Authentication → SMTP / Email):
#   Host: smtp.resend.com
#   Port: 465
#   User: resend
#   Pass: re_... (Resend API key)
#   Sender: your verified domain email
# Supabase Auth sends magic-link + {{ .Token }} OTP through that SMTP.
# The SportzArena app only calls supabase.auth.signInWithOtp / verifyOtp.
# ---------------------------------------------------------------------------
